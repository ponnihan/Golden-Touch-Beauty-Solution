<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Golden Touch | Order Desk</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><script src="supabase-config.js"></script>
<style>
:root{--ink:#20190f;--gold:#c79b4d;--cream:#faf7f0;--line:#e6dece;--muted:#70695d;--green:#20754b;--red:#a33a35}*{box-sizing:border-box}body{margin:0;background:#f4f1ea;color:var(--ink);font:14px Arial,sans-serif}button,input,select,textarea{font:inherit}button{border:0;border-radius:8px;background:#231b10;color:#f6e5bd;padding:10px 14px;cursor:pointer;font-weight:700}button:disabled{opacity:.55;cursor:wait}.wrap{max-width:1450px;margin:auto;padding:18px}.top{background:#17120c;color:#f4e4bd;padding:17px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.top strong{font:22px Georgia;color:#e3c17e}.top small{display:block;color:#c8b993;margin-top:5px}.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;margin:14px 0;box-shadow:0 3px 14px #33230a0a}.login{max-width:440px;margin:9vh auto}h1,h2,h3{font-family:Georgia,serif;margin:0 0 12px}h2{font-size:24px}label{display:block;margin:10px 0 5px;color:#4b4030}input,select,textarea{width:100%;padding:11px;border:1px solid #d8cebb;border-radius:7px;background:#fff;color:#20190f}textarea{min-height:70px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:12px}.stat{background:#fcfaf6;border:1px solid var(--line);border-radius:10px;padding:15px}.stat small{display:block;color:var(--muted)}.stat b{display:block;font-size:25px;margin-top:8px}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0}.tabs button{background:#e9e0d0;color:#352817}.tabs button.active{background:#2a2115;color:#f2dba8}.muted{color:var(--muted)}.notice{padding:10px;background:#f7f0df;border-radius:8px;margin-top:10px;white-space:pre-wrap}.hidden{display:none!important}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:11px;border-bottom:1px solid var(--line);vertical-align:top}th{color:#7a5821;background:#fbf8f1}.status{display:inline-block;background:#f2e8d4;border-radius:20px;padding:4px 8px;font-size:11px}.item{border-top:1px solid var(--line);padding:12px 0;display:grid;grid-template-columns:minmax(180px,1fr) minmax(140px,210px);gap:12px}.actions{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.actions select{min-width:140px}.danger{background:#a33a35;color:white}.secondary{background:#ece5d8;color:#332817}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 12px}.formgrid .wide{grid-column:1/-1}.right{display:flex;justify-content:flex-end;gap:8px}.pill{font-size:12px;color:var(--green)}a{color:#896221}@media(max-width:650px){.wrap{padding:10px}.card{padding:13px}.item{grid-template-columns:1fr}.formgrid{grid-template-columns:1fr}.formgrid .wide{grid-column:auto}}
</style></head><body>
<header class="top"><div><strong>GOLDEN TOUCH · ORDER DESK</strong><small>Manage customer orders and shop products</small></div><div class="actions"><span id="signedInAs"></span><button id="refreshBtn" class="secondary hidden" onclick="refreshAll()">Refresh</button><button id="logoutBtn" class="secondary hidden" onclick="signOut()">Sign out</button></div></header>
<main class="wrap">
<section id="loginPanel" class="card login"><h2>Admin login</h2><p class="muted">Sign in with the authorized Golden Touch administrator account.</p><label>Email</label><input id="email" type="email" autocomplete="username" value="ponni171196@gmail.com"><label>Password</label><input id="password" type="password" autocomplete="current-password"><div class="actions"><button onclick="signIn()">Sign in</button><button class="secondary" onclick="resetPassword()">Forgot password?</button></div><div id="loginMessage" class="notice hidden"></div></section>
<section id="appPanel" class="hidden">
<div class="grid" id="stats"></div>
<nav class="tabs"><button class="active" data-tab="orders" onclick="showTab('orders',this)">Orders</button><button data-tab="products" onclick="showTab('products',this)">Products</button><button data-tab="settings" onclick="showTab('settings',this)">Store settings</button></nav>
<section id="ordersTab" class="card"><div class="actions" style="justify-content:space-between"><div><h2>Customer orders</h2><p class="muted">New guest and account orders appear here.</p></div><select id="orderFilter" style="max-width:190px" onchange="loadOrders()"><option value="all">All orders</option><option value="pending">Pending</option><option value="confirmed">Confirmed</option><option value="processing">Processing</option><option value="packed">Packed</option><option value="shipped">Shipped</option><option value="out_for_delivery">Out for delivery</option><option value="delivered">Delivered</option><option value="cancelled">Cancelled</option></select></div><div id="ordersList" class="muted">Loading orders…</div></section>
<section id="productsTab" class="card hidden"><h2>Products</h2><form id="productForm" onsubmit="saveProduct(event)"><input type="hidden" id="productId"><div class="formgrid"><div><label>Product name *</label><input id="productName" required maxlength="160"></div><div><label>Category</label><input id="productCategory" placeholder="Skincare"></div><div><label>Price (BDT) *</label><input id="productPrice" type="number" min="0" step="0.01" required></div><div><label>Stock quantity *</label><input id="productStock" type="number" min="0" step="1" required></div><div class="wide"><label>Description</label><textarea id="productDescription"></textarea></div><div class="wide"><label>Product image URL (optional)</label><input id="productImage" type="url" placeholder="https://..."></div><div class="wide"><label><input id="productActive" type="checkbox" checked style="width:auto"> Show product on website</label></div></div><div class="actions"><button id="saveProductButton" type="submit">Add product</button><button type="button" class="secondary" onclick="resetProductForm()">Clear</button></div></form><hr style="border:0;border-top:1px solid var(--line);margin:18px 0"><div id="productsList">Loading products…</div></section>
<section id="settingsTab" class="card hidden"><h2>Store settings</h2><p class="muted">These settings are used by your public shop and checkout.</p><form onsubmit="saveSettings(event)"><div class="formgrid"><div><label>Delivery charge (BDT)</label><input id="deliveryCharge" type="number" min="0" step="0.01"></div><div><label>WhatsApp number (international format)</label><input id="whatsappNumber" placeholder="8801XXXXXXXXX"></div><div><label>Contact phone</label><input id="contactPhone"></div></div><button type="submit">Save settings</button></form></section>
<div id="appMessage" class="notice hidden"></div>
</section></main>
<script>
const $=id=>document.getElementById(id);let db=null,currentOrders=[],currentProducts=[];const ADMIN=(window.GT_ADMIN_EMAIL||'').toLowerCase();
function message(id,text,isError=false){const el=$(id);el.textContent=text;el.classList.remove('hidden');el.style.background=isError?'#fae9e7':'#f7f0df'}
function money(n){return '৳ '+Number(n||0).toLocaleString('en-BD',{maximumFractionDigits:2})}
function safe(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
async function signIn(){const email=$('email').value.trim().toLowerCase(),password=$('password').value;if(!db)return message('loginMessage','Supabase is unavailable.',true);if(email!==ADMIN)return message('loginMessage','This email is not authorized as the Golden Touch administrator.',true);const {data,error}=await db.auth.signInWithPassword({email,password});if(error)return message('loginMessage',error.message,true);if((data.user?.email||'').toLowerCase()!==ADMIN){await db.auth.signOut();return message('loginMessage','Access denied.',true)}await showApp(data.user)}
async function resetPassword(){const email=$('email').value.trim();if(!email)return message('loginMessage','Enter your admin email first.',true);const {error}=await db.auth.resetPasswordForEmail(email,{redirectTo:location.href});message('loginMessage',error?error.message:'If this account is registered, a password reset email has been sent.',!!error)}
async function signOut(){await db.auth.signOut();$('appPanel').classList.add('hidden');$('loginPanel').classList.remove('hidden');$('logoutBtn').classList.add('hidden');$('refreshBtn').classList.add('hidden');$('signedInAs').textContent=''}
async function showApp(user){if((user?.email||'').toLowerCase()!==ADMIN){await db.auth.signOut();return} $('loginPanel').classList.add('hidden');$('appPanel').classList.remove('hidden');$('logoutBtn').classList.remove('hidden');$('refreshBtn').classList.remove('hidden');$('signedInAs').textContent=user.email;await refreshAll()}
async function refreshAll(){await Promise.all([loadOrders(),loadProducts(),loadSettings()]);renderStats()}
function showTab(tab,btn){['orders','products','settings'].forEach(x=>$(x+'Tab').classList.toggle('hidden',x!==tab));document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('active',x===btn))}
async function loadOrders(){let q=db.from('orders').select('id,tracking_code,customer_name,phone,address,division,district,total,subtotal,delivery_charge,payment_method,status,created_at,notes,order_items(id,product_name,unit_price,quantity,line_total)').order('created_at',{ascending:false}).limit(200);const filter=$('orderFilter')?.value||'all';if(filter!=='all')q=q.eq('status',filter);const {data,error}=await q;if(error){$('ordersList').textContent='Could not load orders: '+error.message;return}currentOrders=data||[];renderOrders();renderStats()}
function renderOrders(){if(!currentOrders.length){$('ordersList').innerHTML='<p class="muted">No orders found for this filter.</p>';return}$('ordersList').innerHTML=currentOrders.map(o=>`<article class="item"><div><b>${safe(o.customer_name)}</b> <span class="status">${safe(o.status)}</span><p class="muted">${safe(o.tracking_code||o.id)} · ${new Date(o.created_at).toLocaleString()}</p><p><b>${safe(o.phone)}</b><br>${safe([o.division,o.district,o.address].filter(Boolean).join(', '))}</p><p>${(o.order_items||[]).map(i=>`${safe(i.product_name)} × ${i.quantity} — ${money(i.line_total??i.unit_price*i.quantity)}`).join('<br>')||'No item details'}</p><p class="muted">Payment: ${safe(o.payment_method)} · Subtotal: ${money(o.subtotal)} · Delivery: ${money(o.delivery_charge)} · <b>Total: ${money(o.total)}</b></p>${o.notes?`<p class="muted">Note: ${safe(o.notes)}</p>`:''}</div><div><label>Update status</label><select id="status-${o.id}">${['pending','confirmed','processing','packed','shipped','out_for_delivery','delivered','cancelled'].map(s=>`<option value="${s}" ${s===o.status?'selected':''}>${s.replaceAll('_',' ')}</option>`).join('')}</select><input id="note-${o.id}" placeholder="Optional note / cancellation reason"><button onclick="updateStatus('${o.id}')">Save status</button><button class="secondary" onclick="copyOrder('${o.id}')">Copy details</button></div></article>`).join('')}
async function updateStatus(id){const status=$('status-'+id).value,note=$('note-'+id).value.trim();const {error}=await db.rpc('admin_set_order_status',{p_order_id:id,p_status:status,p_note:note||null});if(error){message('appMessage','Status update failed: '+error.message,true);return}message('appMessage','Order status updated.');await loadOrders()}
function copyOrder(id){const o=currentOrders.find(x=>x.id===id);if(!o)return;const txt=`${o.tracking_code||o.id}\n${o.customer_name} · ${o.phone}\n${o.address}\n${(o.order_items||[]).map(i=>`${i.product_name} x${i.quantity}`).join('\n')}\nTotal ${money(o.total)} · ${o.status}`;if(!navigator.clipboard?.writeText){message('appMessage',txt);return}navigator.clipboard.writeText(txt).then(()=>message('appMessage','Order details copied.')).catch(()=>message('appMessage',txt))}
async function loadProducts(){const {data,error}=await db.from('products').select('id,name,category,description,price,stock,image_url,is_active,created_at').order('created_at',{ascending:false});if(error){$('productsList').textContent='Could not load products: '+error.message;return}currentProducts=data||[];renderProducts();renderStats()}
function renderProducts(){if(!currentProducts.length){$('productsList').innerHTML='<p class="muted">No products yet. Add your first product above.</p>';return}$('productsList').innerHTML='<div class="tablewrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Website status</th><th>Action</th></tr></thead><tbody>'+currentProducts.map(p=>`<tr><td><b>${safe(p.name)}</b><br><small>${safe(p.description||'')}</small></td><td>${safe(p.category||'—')}</td><td>${money(p.price)}</td><td>${p.stock}</td><td>${p.is_active?'Visible':'Hidden'}</td><td><button class="secondary" onclick="editProduct('${p.id}')">Edit</button><button class="${p.is_active?'danger':''}" onclick="toggleProduct('${p.id}',${!p.is_active})">${p.is_active?'Hide':'Show'}</button></td></tr>`).join('')+'</tbody></table></div>'}
function editProduct(id){const p=currentProducts.find(x=>x.id===id);if(!p)return;$('productId').value=p.id;$('productName').value=p.name;$('productCategory').value=p.category||'';$('productPrice').value=p.price;$('productStock').value=p.stock;$('productDescription').value=p.description||'';$('productImage').value=p.image_url||'';$('productActive').checked=!!p.is_active;$('saveProductButton').textContent='Save product';$('productName').focus();window.scrollTo({top:0,behavior:'smooth'})}
function resetProductForm(){$('productForm').reset();$('productId').value='';$('productActive').checked=true;$('saveProductButton').textContent='Add product'}
async function saveProduct(e){e.preventDefault();const id=$('productId').value;const row={name:$('productName').value.trim(),category:$('productCategory').value.trim()||null,price:Number($('productPrice').value),stock:Number($('productStock').value),description:$('productDescription').value.trim()||null,image_url:$('productImage').value.trim()||null,is_active:$('productActive').checked};if(!row.name||row.price<0||row.stock<0||!Number.isInteger(row.stock))return message('appMessage','Check the product name, price and stock.',true);let result=id?await db.from('products').update(row).eq('id',id):await db.from('products').insert(row);if(result.error){message('appMessage','Product save failed: '+result.error.message,true);return}message('appMessage',id?'Product updated.':'Product added.');resetProductForm();await loadProducts()}
async function toggleProduct(id,visible){const {error}=await db.from('products').update({is_active:visible}).eq('id',id);if(error){message('appMessage','Could not update product: '+error.message,true);return}await loadProducts();message('appMessage',visible?'Product is now visible.':'Product hidden from the website.')}
async function loadSettings(){const {data,error}=await db.from('store_settings').select('key,value');if(error){message('appMessage','Settings could not be loaded: '+error.message,true);return}const m=Object.fromEntries((data||[]).map(x=>[x.key,x.value]));$('deliveryCharge').value=m.delivery_charge??'30';$('whatsappNumber').value=m.whatsapp||'8801990941408';$('contactPhone').value=m.phone||m.contact_phone||'01990941408'}
async function saveSettings(e){e.preventDefault();const values={delivery_charge:String(Math.max(0,Number($('deliveryCharge').value)||0)),whatsapp:$('whatsappNumber').value.trim(),phone:$('contactPhone').value.trim()};for(const [key,value] of Object.entries(values)){const {error}=await db.from('store_settings').upsert({key,value,updated_at:new Date().toISOString()},{onConflict:'key'});if(error){message('appMessage','Could not save '+key+': '+error.message,true);return}}message('appMessage','Store settings saved.');await loadSettings()}
function renderStats(){const pending=currentOrders.filter(x=>x.status==='pending').length,complete=currentOrders.filter(x=>x.status==='delivered').length,visible=currentProducts.filter(x=>x.is_active).length,stock=currentProducts.reduce((s,x)=>s+(Number(x.stock)||0),0);$('stats').innerHTML=[['Orders (loaded)',currentOrders.length],['Pending',pending],['Delivered',complete],['Visible products',visible],['Units in stock',stock]].map(x=>`<div class="stat"><small>${x[0]}</small><b>${x[1]}</b></div>`).join('')}
document.addEventListener('DOMContentLoaded',async()=>{if(!window.supabase||!window.GT_SUPABASE_URL||!window.GT_SUPABASE_ANON_KEY){message('loginMessage','Store connection could not be initialized.',true);return}db=window.supabase.createClient(window.GT_SUPABASE_URL,window.GT_SUPABASE_ANON_KEY);const {data:{session}}=await db.auth.getSession();if(session?.user)await showApp(session.user);db.auth.onAuthStateChange((_event,session)=>{if(session?.user)showApp(session.user)})});
</script></body></html>
